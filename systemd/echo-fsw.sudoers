# /etc/sudoers.d/echo-fsw
#
# NOT USED by the services in this build — we just run the watchdog as root
# because it's simpler and the risk surface is tiny. Keeping this file as
# a reference in case we want to de-privilege the watchdog later.
#
# If you decide to run echo-watchdog.service as User=f25-echo2 instead of
# root, install this file at /etc/sudoers.d/echo-fsw with:
#     sudo visudo -cf /path/to/this/file      # validate
#     sudo install -m 0440 -o root -g root \
#          systemd/echo-fsw.sudoers /etc/sudoers.d/echo-fsw
# and change the watchdog to shell out with ["sudo", "-n", "systemctl", ...].
#
# Also required for app.py's RTC sync (hwclock) and apogee-video trigger:

f25-echo2 ALL=(root) NOPASSWD: /usr/bin/systemctl restart echo-telem.service
f25-echo2 ALL=(root) NOPASSWD: /usr/bin/systemctl restart echo-radio.service
f25-echo2 ALL=(root) NOPASSWD: /usr/bin/systemctl is-active *
f25-echo2 ALL=(root) NOPASSWD: /usr/bin/systemctl is-failed *
f25-echo2 ALL=(root) NOPASSWD: /usr/bin/systemctl start apogee-video.service
f25-echo2 ALL=(root) NOPASSWD: /usr/sbin/hwclock --set --date *
f25-echo2 ALL=(root) NOPASSWD: /usr/sbin/hwclock -w
f25-echo2 ALL=(root) NOPASSWD: /usr/sbin/hwclock -s
f25-echo2 ALL=(root) NOPASSWD: /usr/sbin/reboot
