[Unit]
Description=Echo FSW Watchdog Supervisor
# Start last, after the services it supervises have at least had a chance
# to activate.
After=echo-telem.service echo-radio.service

[Service]
Type=notify

# Needs root to restart other units via systemctl and to call `reboot` on
# escalation. This is the ONLY FSW unit that runs as root.
User=root
Group=root

WorkingDirectory=/home/f25-echo2/echo_fsw

Environment=PYTHONPATH=/home/f25-echo2/echo_fsw
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/f25-echo2/echo_fsw/venv/bin/python /home/f25-echo2/echo_fsw/watchdog/watchdog.py

# The watchdog pings itself every ~1s.
WatchdogSec=10s
Restart=on-failure
RestartSec=5

StandardInput=null
StandardOutput=journal
StandardError=journal
TTYReset=no

[Install]
WantedBy=multi-user.target
