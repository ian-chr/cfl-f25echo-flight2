# ==========================================================
#   PYTHON BUILD / CACHE FILES
# ==========================================================
**/__pycache__/
*.pyc
*.pyo
*.pyd

# VSCode / IDE
.vscode/
.idea/

# ==========================================================
#   RUNTIME DATA (NEVER COMMIT)
# ==========================================================

# ---- Camera images ----
data/camera/photos/full/
data/camera/photos/thumb/
!data/camera/photos/.gitkeep

# ---- Logs ----
data/logs/
!data/logs/.gitkeep

# ---- Telemetry output ----
data/telemetry/telemetry.csv
data/telemetry/*.csv
!data/telemetry/.gitkeep
!data/telemetry/boot_count.txt   # keep boot counter

# ---- GPS ----
data/gps/gps_nmea_data.csv
!data/gps/.gitkeep

# ---- Magnetometer ----
data/mag/mag_data.csv
!data/mag/.gitkeep

# ---- Cosmic muon ----
data/cwmuon/*.txt
!data/cwmuon/.gitkeep

# ==========================================================
#   IMAGE / LARGE FILE SAFETY
# ==========================================================

# Never commit JPGs anywhere
*.jpg
*.jpeg
*.png

# ==========================================================
#   USER / SESSION / LOCAL MACHINE FILES
# ==========================================================
.python_history
.xsession-errors*
.sudo_as_admin_successful

# Bash / shell history
.bash_history

# System-specific junk
.DS_Store
Thumbs.db
*.swp
*.swo