#!/usr/bin/env python3
"""Fake `rpicam-vid`. Backs telem_deps/sensors/camera_worker.py's
altitude-triggered video capture and the apogee-video one-shot. Nothing
in the FSW ever parses video *content* (only os.path.exists/getsize), so
this writes a plausibly-sized placeholder file rather than a real H.264
stream. Sleeps a scaled-down fraction of the requested duration so the
apogee-video/photo-cycle camera-lock contention noted in CHANGES.md is
still exercised, without a full mission rehearsal actually blocking for
30 real seconds.
"""
import os
import sys
import time

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, REPO_ROOT)

from sim.config import get_config  # noqa: E402

BITRATE_BYTES_PER_SEC = 180_000  # ~1.4 Mbps placeholder H.264 bitrate


def _parse_args(argv):
    opts = {"duration_ms": 15000, "out": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-o" and i + 1 < len(argv):
            opts["out"] = argv[i + 1]; i += 2
        elif a in ("-t", "--timeout") and i + 1 < len(argv):
            opts["duration_ms"] = int(argv[i + 1]); i += 2
        else:
            i += 1
    return opts


def main(argv):
    opts = _parse_args(argv)
    if not opts["out"]:
        print("rpicam-vid: no -o output path given", file=sys.stderr)
        return 1

    cfg = get_config()
    scale = max(1.0, cfg.time_scale)
    duration_s = opts["duration_ms"] / 1000.0
    time.sleep(min(duration_s, max(0.5, duration_s / scale)))

    os.makedirs(os.path.dirname(opts["out"]), exist_ok=True)
    size_bytes = int(duration_s * BITRATE_BYTES_PER_SEC)
    with open(opts["out"], "wb") as f:
        f.write(b"\x00\x00\x00\x01SIMH264PLACEHOLDER")
        f.seek(size_bytes - 1)
        f.write(b"\x00")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
